{
    "watch_path": "workspace",

    "mirror_path": "../EaglEs-EyE-data/mirror",

    "memory_path": "../EaglEs-EyE-data/memory",

    "chunk_size": 1200,

    "chunk_overlap": 200,

    "max_index_bytes": 5242880,

    "verbose_indexing": false,

    "ignore": [
        ".venv",
        ".git",
        "__pycache__",
        "build",
        ".dart_tool",
        "node_modules",
        "mirror",
        "memory",
        "logs",
        "cache",
        "embeddings",
        "vector_db"
    ]
}
